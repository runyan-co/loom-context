{
    "name": "runyan-co/loom-context",
    "description": "Turn a Loom recording into context an AI agent can read: the transcript aligned to de-duplicated screenshots.",
    "type": "project",
    "keywords": [
        "loom",
        "agent-skill",
        "claude",
        "transcript",
        "screenshots",
        "yt-dlp",
        "ffmpeg"
    ],
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Alex Runyan",
            "email": "alex@runyan.co"
        }
    ],
    "require": {
        "php": "^8.3",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/dotenv": "^7.4 || ^8.0",
        "symfony/http-client": "^7.4 || ^8.0",
        "symfony/process": "^7.4 || ^8.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "LoomContext\\": "src/"
        },
        "files": [
            "src/bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    }
}
